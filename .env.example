# ============================================================
# Semantic Brain — Configuration Template
# Copy file này thành .env và điền giá trị thực tế
# ============================================================

# --- PostgreSQL Database ---
SEMANTIC_DB_HOST=localhost
SEMANTIC_DB_PORT=5432
SEMANTIC_DB_NAME=agent_registry
SEMANTIC_DB_USER=postgres
SEMANTIC_DB_PASS=

# --- Ollama Local LLM ---
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen2.5-coder:3b

# --- Embedding Model (Xenova/BGE-M3 chạy local, không cần API) ---
EMBEDDING_MODEL=Xenova/bge-m3
EMBEDDING_DIMS=1024

# --- Server ---
SEMANTIC_PORT=3457
BIND_HOST=127.0.0.1
# Đặt token để bật Bearer auth. Để trống = chỉ chạy local (BIND_HOST=127.0.0.1).
SEMANTIC_API_TOKEN=
# Token riêng cho OpenAI proxy (nếu khác SEMANTIC_API_TOKEN).
PROXY_API_TOKEN=
PROXY_PORT=3458
PROXY_CORS_ORIGIN=*
MAX_BODY_BYTES=1048576

# --- Memory backend (Phase 0: PostgreSQL canonical) ---
MEMORY_BACKEND=postgres
AME_ENABLED=false
AME_WRITE=false

# --- Safety switches ---
# Không tự sinh/lưu câu trả lời khi retrieval MISS.
AUTO_QA_ENABLED=false
# Proxy không tự học; agent gọi /ingest với atomic JSON.
# Chỉ dùng use_count trong ranking khi đã có đủ feedback.
USE_SIGNAL=false
RETRIEVAL_CANDIDATE_K=100
RETRIEVAL_MIN_SIMILARITY=0.38

# --- Domain Context (dùng trong system prompt khi LLM trả lời) ---
# Ví dụ: "chuyên gia hệ thống ERP MDS WinForms"
#         "chuyên gia hệ thống HelpDesk Node.js/MongoDB"
DOMAIN_NAME=My Project
DOMAIN_DESCRIPTION=chuyên gia hệ thống phần mềm

# --- Agent Registry Root (optional) ---
# Thư mục gốc chứa skills/workflows — dùng để resolve path tương đối trong find-skill
# Ví dụ: E:\00.ERP\ERP\.agent
# Để trống nếu không dùng skill registry
AGENT_ROOT=

# --- Cloud LLM Fallback (optional — dùng khi Ollama offline) ---
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
